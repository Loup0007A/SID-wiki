# Copie ce fichier en .env.local puis renseigne les valeurs du projet Supabase
# (Supabase → Project Settings → API). C'est le MÊME projet que le Dossier Central et la Cartographie.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Facultatif : lien « Pas encore de compte ? » affiché sur la page de connexion.
NEXT_PUBLIC_DOSSIER_CENTRAL_URL=
